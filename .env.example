# Chutes.ai API Configuration Example
# This is a template file - copy it to .env and fill in your actual values
# The .env file is gitignored and will NOT be committed to version control

# Your Chutes.ai API Key
# Get your key from: https://chutes.ai/app/api
CHUTES_API_KEY=your_api_key_here

# Environment: production or sandbox
CHUTES_ENVIRONMENT=production

# Optional: Custom API URL (leave empty to use default)
# Only set this if you need a custom endpoint
CHUTES_CUSTOM_URL=

# Sign in With Chutes (OAuth) - Server Admin Configuration
# Set these to enable OAuth authentication in the Chutes nodes.
# Run: npx n8n-nodes-chutes-setup-oauth to register an OAuth app and get these values.
# Without these, only API Key authentication is available.
CHUTES_OAUTH_CLIENT_ID=
CHUTES_OAUTH_CLIENT_SECRET=

# Single-Account Mode (Advanced)
# When set, one Chutes account pays for all inference on this n8n instance.
# Users only need to save an empty credential -- no API key or OAuth required.
# These are set automatically by the CLI wizard in single-account mode.
CHUTES_SERVER_ACCESS_TOKEN=
CHUTES_SERVER_REFRESH_TOKEN=

# Optional: Override the identity provider base URL (default: https://api.chutes.ai)
# CHUTES_IDP_BASE_URL=https://api.chutes.ai
